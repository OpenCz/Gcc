# Reverse proxy + HTTPS automatique (Let's Encrypt)
# DuckDNS ne supporte pas les sous-sous-domaines (api.codingclub.duckdns.org).
# Frontend et API partagent le meme domaine, routes par chemin.
#
#   {$DOMAIN}             -> frontend (SPA React / nginx)
#   {$DOMAIN}/auth/*      -> backend (Elysia)
#   {$DOMAIN}/admin/*     -> backend
#   {$DOMAIN}/manta/*     -> backend
#   {$DOMAIN}/prospect/*  -> backend
#   {$DOMAIN}/uploads/*   -> backend (fichiers statiques)

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	@api path /auth/* /admin/* /manta/* /prospect/* /uploads/*
	reverse_proxy @api backend:8080

	reverse_proxy frontend:80
}
