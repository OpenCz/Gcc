# Domaine & HTTPS (Caddy)
# DOMAIN sans "https://" ni "www". Caddy gere DOMAIN et api.DOMAIN.
DOMAIN=tondomaine.fr
ACME_EMAIL=ton.email@exemple.com

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gcc_db

# Backend
DATABASE_URL=postgresql://postgres:change_me@db:5432/gcc_db
JWT_SECRET=change_me_in_production
ADMIN_SECRET=change_me_in_production
FRONTEND_URL=https://yourdomain.com
UPLOADS_DIR=/app/uploads

# Microsoft OAuth (my.epitech.eu)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://yourdomain.com/auth/callback
MICROSOFT_TENANT_ID=

# Frontend
API_URL=https://api.yourdomain.com
